{
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openai/codex": "0.160.0",
    "@openai/codex-sdk": "0.160.0",
    "@sidearker/vex-mcp": "^0.1.1",
    "bonjour-service": "^1.4.4",
    "ink": "^7.1.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "name": "@sidearker/pace",
  "version": "1.0.1",
  "private": false,
  "files": [
    "dist/",
    "bin/",
    "routing-prompts.default.json",
    "versions.json",
    "skills/"
  ],
  "description": "Independent terminal coding client powered by Codex App Server, with optional Vex model routing and a VS Code plan reader.",
  "bin": {
    "pace": "dist/entrypoints/cli.js",
    "vex": "bin/vex.js",
    "jev": "bin/jev.js"
  },
  "main": "index.js",
  "scripts": {
    "test": "vitest run --pool=threads --maxWorkers=1 --exclude '**/extensions/**'",
    "dev": "tsx src/entrypoints/cli.ts",
    "build": "tsc",
    "start": "node dist/entrypoints/cli.js",
    "benchmark": "tsx benchmark/runner/workflows.ts",
    "benchmark:thread-switch": "tsx benchmark/thread-switch.ts",
    "benchmark:context-quality": "tsx benchmark/context-quality.ts",
    "benchmark:routing": "npm run build && node dist/entrypoints/routing-benchmark.js",
    "benchmark:grade": "tsx benchmark/grading/grade.ts",
    "benchmark:check": "tsc -p benchmark/tsconfig.json",
    "prepare": "npm run build",
    "benchmark:task-control": "tsx benchmark/task-control.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SideArker/Pace.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SideArker/Pace/issues"
  },
  "homepage": "https://github.com/SideArker/Pace#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
