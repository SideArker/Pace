{
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openai/codex": "0.160.0",
    "@openai/codex-sdk": "0.160.0",
    "@sidearker/vex-mcp": "^0.1.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0"
  },
  "name": "pace",
  "version": "0.1.0",
  "description": "Terminal coding client using Codex App Server and Vex MCP routing",
  "bin": {
    "pace": "dist/entrypoints/cli.js",
    "vex": "bin/vex.js",
    "jev": "bin/jev.js"
  },
  "main": "index.js",
  "scripts": {
    "test": "vitest run --pool=threads --maxWorkers=1 --exclude '**/extensions/**'",
    "dev": "tsx src/entrypoints/cli.ts",
    "build": "tsc",
    "start": "node dist/entrypoints/cli.js",
    "benchmark": "tsx benchmark/runner/workflows.ts",
    "benchmark:thread-switch": "tsx benchmark/thread-switch.ts",
    "benchmark:context-quality": "tsx benchmark/context-quality.ts",
    "benchmark:routing": "npm run build && node dist/entrypoints/routing-benchmark.js",
    "benchmark:grade": "tsx benchmark/grading/grade.ts",
    "benchmark:check": "tsc -p benchmark/tsconfig.json",
    "prepare": "npm run build",
    "postinstall": "node bin/setup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SideArker/Pace.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SideArker/Pace/issues"
  },
  "homepage": "https://github.com/SideArker/Pace#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
